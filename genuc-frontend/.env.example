# Variables d'environnement GENUC Frontend
# ⚠️ Ne jamais commiter ce fichier avec des valeurs sensibles !
# Copie ce fichier en .env.local et remplis les valeurs

# ======================================
# BACKEND API
# ======================================
REACT_APP_API_BASE_URL=http://localhost:8082
REACT_APP_API_TIMEOUT=10000

# ======================================
# ENDPOINTS
# ======================================
REACT_APP_AUTH_ENDPOINT=/api/auth
REACT_APP_PAIEMENT_ENDPOINT=/api/paiements
REACT_APP_INSCRIPTION_ENDPOINT=/api/inscriptions

# ======================================
# FRONTEND CONFIG
# ======================================
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug

# ======================================
# SÉCURITÉ
# ======================================
REACT_APP_JWT_TOKEN_KEY=genuc_token
REACT_APP_REFRESH_TOKEN_KEY=genuc_refresh_token
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ======================================
# PAGINATION
# ======================================
REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100

# ======================================
# NOTIFICATIONS
# ======================================
REACT_APP_TOAST_POSITION=bottom-right
REACT_APP_TOAST_DURATION=3000

# ======================================
# NOTIFICATIONS PUSH (Firebase Cloud Messaging)
# Laisser vide pour désactiver les notifications push (aucune erreur, juste ignoré)
# ======================================
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=
