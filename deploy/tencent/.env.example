# Gabarit des variables de la pile de production GENUC.
#
#   cp deploy/tencent/.env.example deploy/tencent/.env
#   # renseigner, puis :
#   docker compose -f deploy/tencent/docker-compose.prod.yml --env-file deploy/tencent/.env up -d --build
#
# deploy/tencent/.env est ignoré par git (**/.env.*). Ne jamais le committer :
# c'est exactement de cette façon que 9 secrets se sont retrouvés sur un dépôt
# GitHub public en juillet 2026.
#
# Générer une valeur aléatoire solide :
#   openssl rand -base64 48

# ─── Base de données ────────────────────────────────────────────────
DB_NAME=genuc_db
DB_USERNAME=genuc_user
# OBLIGATOIRE
DB_PASSWORD=

# ─── Redis ──────────────────────────────────────────────────────────
# Facultatif, mais recommandé. Redis n'est pas exposé hors du CVM ;
# un mot de passe protège en plus des autres conteneurs de la machine.
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────────────
# OBLIGATOIRE. 64 caractères minimum (JwtService refuse en dessous de 32).
# Ce secret signe TOUS les jetons : quiconque le détient peut forger un
# jeton SUPER_ADMIN valide. Le renouveler déconnecte tout le monde — c'est
# le comportement attendu.
JWT_SECRET=

# ─── URLs publiques ─────────────────────────────────────────────────
# OBLIGATOIRE. Origine publique du frontend : construit tous les liens
# envoyés par mail et les QR de vérification de documents.
# En HTTP tant que le domaine n'est pas en place : http://<IP publique du CVM>
APP_BASE_URL=https://genuc.cd

# OBLIGATOIRE. Doit correspondre EXACTEMENT à l'origine du navigateur,
# sans slash final. Plusieurs valeurs séparées par des virgules.
CORS_ALLOWED_ORIGINS=https://genuc.cd

# ─── Messagerie (Gmail SMTP) ────────────────────────────────────────
# MAIL_PASSWORD est un mot de passe d'application Google, pas le mot de
# passe du compte.
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Webhooks mobile money ──────────────────────────────────────────
# genuc.webhook.require-signature=true en prod : un webhook non signé est
# rejeté. Renseigner le secret de chaque opérateur réellement branché.
WEBHOOK_SECRET=
WEBHOOK_VODACOM_SECRET=
WEBHOOK_AIRTEL_SECRET=
WEBHOOK_ORANGE_SECRET=
WEBHOOK_AFRIMONEY_SECRET=

# ─── Dimensionnement ────────────────────────────────────────────────
# Valeurs pour un CVM 2 vCPU / 4 Go. À relever avec l'instance.
TOMCAT_MAX_THREADS=25
DB_POOL_SIZE=8
