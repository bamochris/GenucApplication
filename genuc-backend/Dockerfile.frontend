# ─── Étape 1 : Installation des dépendances (cache si package-lock.json inchangé) ─
FROM node:20-alpine AS deps
WORKDIR /app
# .npmrc porte legacy-peer-deps=true : sans lui, npm ci s'arrête en ERESOLVE sur
# le pair react de @react-pdf/renderer. Il doit être copié AVANT npm ci.
COPY genuc-frontend/package.json genuc-frontend/package-lock.json genuc-frontend/.npmrc ./
RUN npm ci --omit=dev --prefer-offline

# ─── Étape 2 : Build React ───────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY genuc-frontend/ ./
# CI=false : warnings ne font pas échouer le build
# GENERATE_SOURCEMAP=false : réduit taille du bundle de 30-40%
ENV CI=false \
    GENERATE_SOURCEMAP=false \
    NODE_ENV=production
RUN npm run build

# ─── Étape 3 : Serveur Nginx optimisé ────────────────────────────────────────
FROM nginx:1.25-alpine AS runtime

# Sécurité : supprimer la page par défaut et les headers de version
RUN rm /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/build /usr/share/nginx/html
# Ce Dockerfile se construit depuis la RACINE du dépôt (il copie genuc-frontend/),
# donc les fichiers de genuc-backend/ sont désignés par leur chemin complet.
#
# La configuration est un GABARIT : le port d'écoute et l'URL du backend ne sont
# connus qu'au démarrage. En Docker Compose ce sont 80 et http://backend:8082 ;
# sur un PaaS (Railway, Render) le port est imposé par $PORT et le backend porte
# un nom d'hôte interne. L'entrypoint rend le gabarit avant de lancer Nginx.
COPY genuc-backend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY genuc-backend/docker-entrypoint-frontend.sh /docker-entrypoint-frontend.sh
RUN chmod +x /docker-entrypoint-frontend.sh

# Indicatif seulement : les PaaS ignorent EXPOSE et imposent $PORT.
EXPOSE 80

# Pas de CMD : l'entrypoint lance Nginx lui-même après avoir rendu le gabarit.
# Un CMD serait passé en arguments au script, qui les ignore — trompeur.
ENTRYPOINT ["/docker-entrypoint-frontend.sh"]
