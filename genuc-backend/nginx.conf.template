server {
    listen __PORT__;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ─── Taille des corps de requête ───────────────────────────────────
    #
    # Sans cette directive, Nginx applique son défaut : 1 Mo. Or plusieurs
    # écrans envoient du multipart bien plus lourd — POST
    # /api/super-admin/universites/etapes joint le logo de l'établissement
    # ET trois PDF (agrément, arrêté ministériel, statuts).
    #
    # Le mode d'échec est trompeur : au-delà de la limite, Nginx renvoie 413
    # puis FERME la connexion alors que le navigateur téléverse encore. Le
    # navigateur ne voit donc pas le 413 mais une connexion réinitialisée,
    # c'est-à-dire une panne réseau. Constaté en production le 03/08/2026 :
    # l'enregistrement d'une université échouait avec « Hors ligne.
    # Reconnectez-vous pour synchroniser. » — le message que le service
    # worker fabriquait pour toute requête réseau échouée — alors que la
    # session était valide et le backend en parfaite santé.
    #
    # La valeur laisse volontairement de la marge sur le plafond Spring
    # (spring.servlet.multipart.max-request-size = 10 Mo dans
    # application.yml) : c'est le backend qui doit refuser un envoi trop
    # gros, avec un JSON explicite, et non le proxy en coupant la ligne.
    client_max_body_size 12m;

    # Un téléversement de 10 Mo sur une connexion lente met plus que les 60 s
    # par défaut à arriver ; sans cela le proxy renonce en cours d'envoi.
    client_body_timeout 120s;

    # ─── Compression GZIP ──────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ─── Headers de sécurité ───────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Masquer la version Nginx
    server_tokens off;

    # ─── Assets statiques : cache 1 an (hash dans le nom de fichier) ───
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ─── SPA React : toutes les routes → index.html ────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        # index.html ne doit pas être mis en cache (navigateur recharge à chaque visite)
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # ─── Proxy API vers le backend Spring Boot ─────────────────────────
    #
    # « ^~ » est indispensable, pas décoratif. Nginx évalue les locations
    # REGEX avant les locations préfixe : sans ce modificateur, la règle de
    # cache des assets ci-dessus (~* \.(js|css|png|jpg|…)$) capturait toute
    # requête /api/ se terminant par une extension d'image, et Nginx la
    # cherchait dans sa racine statique au lieu de la proxifier.
    #
    # Conséquence constatée en production le 02/08/2026 : les fichiers
    # téléversés servis par GET /api/fichiers/<dossier>/<nom> répondaient 404
    # dès que leur nom finissait en .jpg ou .png — logos d'établissement,
    # sceaux, photos d'identité, pièces de dossier scannées. Les mêmes chemins
    # en .pdf fonctionnaient, ce qui rendait le diagnostic contre-intuitif.
    #
    # « ^~ » fait gagner la location préfixe et court-circuite les regex.
    location ^~ /api/ {
        # Résolution DNS à CHAQUE requête, et non une seule fois au démarrage.
        #
        # Avec un nom d'hôte littéral dans proxy_pass, Nginx résout l'adresse au
        # chargement de la configuration et la garde pour toute la durée de vie
        # du processus. Sur un PaaS, le conteneur backend change d'adresse à
        # chaque redéploiement : le frontend continuait alors de viser l'ancienne
        # IP et répondait 504 sur tout /api/, jusqu'à un redémarrage manuel.
        # Constaté en production le 02/08/2026.
        #
        # Passer par une variable force Nginx à interroger le résolveur, avec le
        # TTL indiqué. __RESOLVER__ est renseigné au démarrage depuis
        # /etc/resolv.conf : Docker Compose (127.0.0.11) comme Railway.
        resolver __RESOLVER__ valid=10s;
        set $genuc_backend "__BACKEND_HOSTPORT__";

        # $request_uri porte le chemin complet d'origine, /api/ inclus, ainsi que
        # la chaîne de requête. Nécessaire ici : dès que proxy_pass contient une
        # variable, Nginx cesse de substituer le préfixe de location.
        proxy_pass __BACKEND_SCHEME__://$genuc_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Timeouts adaptés aux endpoints longs (génération PDF, paiements)
        # et aux téléversements multipart (dossiers d'agrément scannés).
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # Buffer pour éviter les writes lentes
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 16 8k;
    }

    # ─── Identité visuelle téléversée : logos, sceaux, certificats ─────
    #
    # Le backend sert /uploads/** en statique, mais UNIQUEMENT pour les trois
    # dossiers d'identité visuelle (universites, logos, certificats) : voir
    # WebConfig et SecurityConfig, qui refusent tout le reste en 403. Ces
    # fichiers doivent rester joignables sans jeton, parce qu'un <img src="…">
    # sur une page publique ne transmet aucun en-tête d'authentification.
    #
    # Sans cette location, Nginx ne proxifiait que /api/ : une requête
    # /uploads/universites/<logo>.jpg tombait sur la règle SPA et renvoyait
    # index.html. Le logo d'établissement ne s'affichait donc nulle part —
    # constaté en production le 02/08/2026.
    #
    # « ^~ » pour la même raison que /api/ : sans lui, la règle regex des
    # assets statiques capturerait ces .jpg/.png avant d'arriver ici.
    location ^~ /uploads/ {
        resolver __RESOLVER__ valid=10s;
        set $genuc_uploads "__BACKEND_HOSTPORT__";
        proxy_pass __BACKEND_SCHEME__://$genuc_uploads$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;

        # Ces fichiers portent un nom en UUID : leur contenu ne change jamais.
        # C'est le chemin qui change quand le logo est remplacé.
        expires 7d;
        add_header Cache-Control "public";
    }

    # ─── Health check (pour load balancer / K8s) ───────────────────────
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # ─── Bloquer les accès aux fichiers cachés ─────────────────────────
    location ~ /\. {
        deny all;
        access_log off;
    }
}
