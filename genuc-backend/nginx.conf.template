server {
    listen __PORT__;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ─── Compression GZIP ──────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ─── Headers de sécurité ───────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Masquer la version Nginx
    server_tokens off;

    # ─── Assets statiques : cache 1 an (hash dans le nom de fichier) ───
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ─── SPA React : toutes les routes → index.html ────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        # index.html ne doit pas être mis en cache (navigateur recharge à chaque visite)
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # ─── Proxy API vers le backend Spring Boot ─────────────────────────
    location /api/ {
        # Résolution DNS à CHAQUE requête, et non une seule fois au démarrage.
        #
        # Avec un nom d'hôte littéral dans proxy_pass, Nginx résout l'adresse au
        # chargement de la configuration et la garde pour toute la durée de vie
        # du processus. Sur un PaaS, le conteneur backend change d'adresse à
        # chaque redéploiement : le frontend continuait alors de viser l'ancienne
        # IP et répondait 504 sur tout /api/, jusqu'à un redémarrage manuel.
        # Constaté en production le 02/08/2026.
        #
        # Passer par une variable force Nginx à interroger le résolveur, avec le
        # TTL indiqué. __RESOLVER__ est renseigné au démarrage depuis
        # /etc/resolv.conf : Docker Compose (127.0.0.11) comme Railway.
        resolver __RESOLVER__ valid=10s;
        set $genuc_backend "__BACKEND_HOSTPORT__";

        # $request_uri porte le chemin complet d'origine, /api/ inclus, ainsi que
        # la chaîne de requête. Nécessaire ici : dès que proxy_pass contient une
        # variable, Nginx cesse de substituer le préfixe de location.
        proxy_pass __BACKEND_SCHEME__://$genuc_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Timeouts adaptés aux endpoints longs (génération PDF, paiements)
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # Buffer pour éviter les writes lentes
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 16 8k;
    }

    # ─── Health check (pour load balancer / K8s) ───────────────────────
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # ─── Bloquer les accès aux fichiers cachés ─────────────────────────
    location ~ /\. {
        deny all;
        access_log off;
    }
}
